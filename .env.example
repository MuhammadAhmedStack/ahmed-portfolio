# ==============================================================================
# Environment Configuration Example
# ==============================================================================
# NOTE: Variables prefixed with VITE_ are exposed to the client-side JavaScript bundle.
# NEVER put private API keys, database passwords, or secret credentials here.
#
# Copy this file to .env.local for local overrides:
# cp .env.example .env.local
# ==============================================================================

# Optional site canonical URL for production deployments
VITE_SITE_URL=https://your-portfolio-domain.com
